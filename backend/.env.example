# Copy to .env and fill in. Never commit the real .env file.

GITHUB_USERNAME=PriyanshuPal24
# Optional personal access token (public_repo scope) to raise the GitHub rate limit
GITHUB_TOKEN=
GITHUB_CACHE_TTL=900

# Comma-separated list of front-end origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Where contact form submissions are emailed
CONTACT_TO_EMAIL=

# Preferred: Resend HTTPS API (works on hosts that block outbound SMTP ports)
RESEND_API_KEY=
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Fallback: SMTP (only used when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

FLASK_DEBUG=0
